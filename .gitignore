# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
/web/data/dive-sites.bak*
/data/dive-sites.bak*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/dist-native/
/.wrangler/
/outputs/
/work/

# fetched native dependency source (see scripts/fetch-libdivecomputer.ps1)
/android/app/src/main/cpp/vendor/

# Android Studio local project metadata
/android/.idea/

# private dive data and local import staging
*.db
*.sqlite
*.sqlite3
*.ssrf
/imports/
/private/
__pycache__/

# Local git worktrees
.worktrees/

# Local spec-driven development work packets (tracked reports remain tracked)
/.superpowers/sdd/

# Local maintainer handoff notes
/docs/.local/

